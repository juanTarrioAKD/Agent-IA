// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//APARTADO DE LOS ROLES Y PERMISOS

model Rol {
  id          Int       @id @default(autoincrement())
  rol         String    @unique

  // Relacion: 1 rol tiene muchos permisos
  permissions Permission[] @relation("RolPermission")
  
  // Relacion inversa: muchos usuarios tienen este rol
  users       User[] @relation("UserRol")
}

model Permission {
  id          Int       @id @default(autoincrement())
  permission  String    @unique

  // Relacion: 1 permiso tiene muchos roles
  roles       Rol[] @relation("RolPermission")
}

//APARTADO DE LOS USUARIOS
model User {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  nombre      String
  apellido    String
  nameUser    String?
  password    String
  createdAt   DateTime  @default(now())
  rolId       Int
  deleted     Boolean   @default(false)
  lastUpdated DateTime  @updatedAt @default(now())

  // Relacion: 1 usuario tiene muchas reviews.
  reviews     Review[]

  // Relacion: 1 usuario tiene 1 rol.
  rol         Rol       @relation(fields: [rolId], references: [id], name: "UserRol")
}

model Libro {
  id          Int       @id @default(autoincrement())
  title       String    @unique
  description String?
  image       String?
  price       Float?
  stock       Int?
  createdAt   DateTime  @default(now())
  deleted     Boolean   @default(false)
  lastUpdated DateTime  @updatedAt @default(now())

  // Relacion: 1 libro tiene muchas reviews.
  reviews     Review[]

}

model Review {
  id          Int       @id @default(autoincrement())
  review      String
  rating      Int?      // Calificación opcional (ej: 1-5 estrellas)
  createdAt   DateTime  @default(now())
  deleted     Boolean   @default(false)
  lastUpdated DateTime  @updatedAt @default(now())
  libroId     Int
  userId      Int

  // Relacion: 1 review tiene 1 libro.
  libro       Libro     @relation(fields: [libroId], references: [id], onDelete: Cascade)
  // Relacion: 1 review tiene 1 usuario.
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}